# Origin of the WAD Judging backend (wad-judging-be), no trailing slash.
# next.config.ts proxies "/api/*" here so the browser only ever talks to
# this app's own origin and the backend's http-only session cookie works
# without any CORS configuration on the backend.
BACKEND_ORIGIN=https://wadjudge.netlify.app

# Base URL client.ts prefixes onto every API call. Keep this pointed at this
# app's own origin (not the backend's) so requests still hit the "/api/*"
# rewrite above instead of going cross-origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
